# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: real news ingestion (falls back to dummy dataset if unset)
NEWS_API_KEY=

# Optional: defaults to a local SQLite file. Set to a Postgres URL to use
# a real instance (e.g. Supabase/Neon free tier, or Railway's Postgres addon).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional: comma-separated companies to auto-run on a schedule when the API starts
# TRACKED_COMPANIES=Tesla,Apple

# Optional: hours between scheduled runs (default 6)
# SCHEDULE_INTERVAL_HOURS=6

# Optional: for dashboard.py, if the API isn't on http://127.0.0.1:8000
# API_BASE_URL=http://127.0.0.1:8000
